# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/fatima?retryWrites=true&w=majority

# Use a unique random value with at least 32 characters in production
AUTH_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

# Local admin sign-in (change before production)
